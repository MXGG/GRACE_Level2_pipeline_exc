# Vendored tool sample/input data.
matlab/src/tools/GRACE-filter-master/data/
matlab/src/tools/GRACE-filter-master/tests/GSM-*
src/matlab/src/tools/GRACE-filter-master/data/
src/matlab/src/tools/GRACE-filter-master/tests/GSM-*

# Input data: keep only directory placeholders and the manifest.
/data/**
!/data/
!/data/**/
!/data/.gitignore
!/data/INPUT_FILES.md
!/data/README.md
!/data/manifest.example.json
!/data/**/.gitkeep
/data/Aux/

# Legacy outputs: keep only local/remote directory placeholders.
/output/**
!/output/
!/output/local/
!/output/remote/
!/output/local/.gitkeep
!/output/remote/.gitkeep

# Canonical outputs: keep only placeholders and README.
/outputs/**
!/outputs/
!/outputs/README.md
!/outputs/local/
!/outputs/remote/
!/outputs/figures/
!/outputs/logs/
!/outputs/local/.gitkeep
!/outputs/remote/.gitkeep
!/outputs/figures/.gitkeep
!/outputs/logs/.gitkeep

# Local scratch and archives
_archive/
_scratch/
tmp/

# Logs and temp files
*.log
*.tmp
