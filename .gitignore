# Python cache/metadata
__pycache__/
*.py[cod]
*.egg-info/
*.egg

# Virtual environments
.venv/
.venv-build/
venv/
venv*/
python/venv/
python/venv*/
python/.venv-build/

# Build artifacts
build/
dist/
dist_preview/
dist_tmp/
release/
python/build/
python/build_preview/
python/dist/
python/output/
python/_pyi_dll_aliases/
python/.venv312_ready
python/files.zip
