{
  "__template": "HPC full filters + basin + leakage FM (HSAF adaptive v6_3-style bands)",
  "path": {
    "GFC": "${ROOT}/data/GRACE/GSM",
    "OUTPUT": "${ROOT}/output",
    "AUX": "${ROOT}/data/Aux",
    "DDK": "${ROOT}/data/Aux/DDK",
    "BOUNDARY": "${ROOT}/data/Boundary/boundary_cache"
  },
  "time": {
    "auto_detect_gfc": true
  },
  "reference": {
    "mascon_dir": "${ROOT}/data/Reference/Mascon",
    "mascon_pattern": "Mascon_{YYYYMM}.nc",
    "allow_nearest_month": true,
    "nearest_month_tolerance_days": 45
  },
  "gldas": {
    "dir": ""
  },
  "io": {
    "return_stacks": true,
    "return_metrics": true,
    "return_basin": true,
    "resume": false
  },
  "metrics": {
    "enable": true
  },
  "parallel": {
    "enable": true,
    "nWorkers": 32
  },
  "filter": {
    "pre_hankel_input": "P4M6",
    "gaussian": { "enable": true },
    "p4m6": { "enable": true },
    "fan": { "enable": true },
    "ddk": { "enable": true, "type": "DDK4" },
    "hankel": {
      "stack_mode": true,
      "variant": "adaptive",
      "Ts": 1,
      "params": {
        "p": 80,
        "K": 28,
        "wl_band_deg": [3, 35],
        "opt": {
          "detrend_mode": "constant",
          "taper_alpha": 0.02,
          "force_conjugate_pairs": true,
          "min_mode_energy_ratio": 0,
          "protect_wl_gt_deg": 1e9,
          "use_sliding": true,
          "win_min": 60,
          "win_overlap": 0.90,
          "ola_window": "hann",
          "ola_tukey_alpha": 0.25,
          "p_cap_ratio": 0.3333,
          "p_min_win": 24,
          "k_min": 6,
          "k_max": 28,
          "k_per_window": false,
          "k_energy": 0.95,
          "circular": true
        }
      },
      "adaptive": [
        { "lat_range": [-90, -60], "params": { "p": 70, "K": 24, "wl_band_deg": [3, 35] } },
        { "lat_range": [-60, -30], "params": { "p": 80, "K": 28, "wl_band_deg": [3, 35] } },
        { "lat_range": [-30,  30], "params": { "p": 100, "K": 32, "wl_band_deg": [3, 35] } },
        { "lat_range": [ 30,  60], "params": { "p": 80, "K": 28, "wl_band_deg": [3, 35] } },
        { "lat_range": [ 60,  90], "params": { "p": 70, "K": 24, "wl_band_deg": [3, 35] } }
      ]
    }
  },
  "basin": {
    "analysis_enable": true,
    "boundary_file": "${ROOT}/data/Boundary/boundary_cache/LargeBasin.shp",
    "name": "LargeBasin"
  },
  "leakage": {
    "enable": true,
    "method": "FM",
    "apply_to": ["RAW","P4M6","GAUSS","FAN","P4M6_GAUSS","P4M6_FAN","DDK4","HSAF"],
    "Lmax": 60,
    "grid_interval": 1,
    "fm_accel": 1.1,
    "fm_metric": "land_weighted_mean",
    "fm_mass_conservation": "legacy_land_mean_fill",
    "FM": {
      "nIter": 2,
      "accel": 1.1,
      "metric": "land_weighted_mean",
      "mass_conservation": "legacy_land_mean_fill"
    }
  },
  "inversion": {
    "Lmax": 60,
    "remove_mean": true,
    "lowdeg": {
      "enable": true,
      "replace_C20": true,
      "replace_C10": true,
      "replace_S20": false,
      "files": {
        "C20": "${ROOT}/data/GRACE/LowDegree/TN-14_C30_C20_GSFC_SLR.txt",
        "DEGREE1": "${ROOT}/data/GRACE/LowDegree/TN-13_GEOC_CSR_RL06.txt"
      }
    }
  }
}


