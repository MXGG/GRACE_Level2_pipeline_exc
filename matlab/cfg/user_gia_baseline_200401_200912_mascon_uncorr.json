{
  "metrics": {
    "enable": false
  },
  "inversion": {
    "Lmax": 60,
    "lowdeg": {
      "files": {
        "C20": "${ROOT}/data/GRACE/LowDegree/TN-14_C30_C20_GSFC_SLR.txt",
        "DEGREE1": "${ROOT}/data/GRACE/LowDegree/TN-13_GEOC_CSR_RL06.txt"
      },
      "replace_C10": true,
      "enable": true,
      "replace_S20": false,
      "replace_C20": true
    },
    "gia": {
      "enable": true
    },
    "remove_mean": true,
    "mean_start_ym": "2004-01",
    "mean_end_ym": "2009-12"
  },
  "reference": {
    "mascon_dir": "${ROOT}/data/Reference/Mascon",
    "mascon_pattern": "Mascon_{YYYYMM}.nc",
    "mascon_undo": {
      "gia_file": "CSR_GRACE_GRACE-FO_RL0603_Mascons_GIA-component.nc",
      "enable": true,
      "gad_file": "CSR_GRACE_GRACE-FO_RL0603_Mascons_GAD-component.nc"
    }
  },
  "gldas": {
    "dir": ""
  },
  "filter": {
    "p4m6": {
      "enable": true
    },
    "pre_hankel_input": "P4M6",
    "gaussian": {
      "enable": true
    },
    "ddk": {
      "enable": true,
      "type": "DDK4"
    },
    "hankel": {
      "stack_mode": true
    },
    "fan": {
      "enable": true
    }
  },
  "__template": "Machine-specific configuration (HPC Cluster)",
  "io": {
    "return_basin": false,
    "return_metrics": false,
    "return_stacks": false,
    "resume": false
  },
  "time": {
    "auto_detect_gfc": true
  },
  "path": {
    "DDK": "${ROOT}/data/Aux/DDK",
    "GFC": "${ROOT}/data/GRACE/GSM",
    "BOUNDARY": "${ROOT}/data/Boundary/boundary_cache",
    "OUTPUT": "${ROOT}/output",
    "AUX": "${ROOT}/data/Aux"
  },
  "parallel": {
    "enable": true,
    "nWorkers": 52
  },
  "__memory_note": "OPTIMIZED: Disabled parallel pool to prevent OOM - HPC memory per job is limited"
}

