{
  "_comment": "GRACE Level-2 Processing Pipeline Configuration",
  "_doc": "Canonical shared configuration location. Legacy copy remains under matlab/cfg during the staged migration.",
  "path": {
    "_comment": "Directory paths - ${ROOT} is auto-resolved to project root",
    "ROOT": "${ROOT}",
    "GFC": "${ROOT}/data/GRACE/GSM",
    "OUTPUT": "${ROOT}/outputs",
    "AUX": "${ROOT}/data/Aux",
    "DDK": "${ROOT}/data/DDK",
    "BOUNDARY": "${ROOT}/data/Boundary/boundary_cache",
    "TOOLBOX": {
      "tool_functions": "${ROOT}/src/matlab/src/tools",
      "m_map": "${ROOT}/src/matlab/src/tools/m_map",
      "gmt": "${ROOT}/src/matlab/src/tools/gmt"
    }
  },
  "reference": {
    "_comment": "Reference data for metrics evaluation",
    "type": "mascon",
    "mascon_dir": "${ROOT}/data/Reference/Mascon",
    "mascon_pattern": "Mascon_{YYYYMM}.mat",
    "allow_nearest_month": true,
    "nearest_month_tolerance_days": 45,
    "mascon_undo": {
      "gad_file": "CSR_GRACE_GRACE-FO_RL0603_Mascons_GAD-component.nc",
      "enable": false,
      "gia_file": "CSR_GRACE_GRACE-FO_RL0603_Mascons_GIA-component.nc"
    }
  },
  "gldas": {
    "_comment": "GLDAS data for GWSA computation and leakage correction",
    "dir": "${ROOT}/data/Hydro/GLDAS",
    "pattern": "GLDAS_NOAH_{YYYYMM}.nc",
    "vars": {
      "tws": "lwe_thickness",
      "soil": [
        "SoilMoi00_10cm_inst",
        "SoilMoi10_40cm_inst",
        "SoilMoi40_100cm_inst"
      ],
      "snow": "SWE_inst",
      "canopy": "CanopyWater_inst"
    }
  },
  "time": {
    "_comment": "Time range configuration",
    "auto_detect_gfc": true,
    "start_ym": "2002-04",
    "end_ym": "2017-06",
    "product_type": "GSM",
    "file_ext": ".gfc"
  },
  "grid": {
    "_comment": "Output grid specification",
    "lon": [-179.5, 179.5],
    "lat": [-89.5, 89.5],
    "dlon": 1.0,
    "dlat": 1.0,
    "unit": "mmEWH"
  },
  "inversion": {
    "_comment": "Spherical harmonic inversion parameters",
    "Lmax": 60,
    "remove_mean": true,
    "mean_baseline_mode": "standard_2004_2009",
    "mean_start_ym": "2004-01",
    "mean_end_ym": "2009-12",
    "lowdeg": {
      "enable": true,
      "replace_C20": true,
      "replace_degree1": true,
      "replace_C10": true,
      "replace_C30": true,
      "files": {
        "C20": "${ROOT}/data/GRACE/LowDegree/TN-14_C30_C20_GSFC_SLR.txt",
        "DEGREE1": "${ROOT}/data/GRACE/LowDegree/TN-13_GEOC_CSR_RL06.txt"
      }
    },
    "gia": {
      "enable": false,
      "file": "${ROOT}/data/GRACE/GIA/GIA_Stokes_ICE-6G_D.txt",
      "Lmax": 60
    }
  },
  "filter": {
    "_comment": "Spectral and spatial filter settings",
    "gaussian": {
      "enable": true,
      "radius_km": 300
    },
    "p4m6": {
      "enable": false,
      "poly_deg": 4,
      "m_start": 6
    },
    "fan": {
      "enable": false,
      "radius1_km": 300,
      "radius2_km": 300
    },
    "ddk": {
      "enable": false,
      "type": "DDK4",
      "data_dir": "${ROOT}/data/DDK"
    },
    "hankel": {
      "enable": false,
      "variant": "global",
      "engine": "matlab_v3",
      "adaptive": [],
      "mode": "profile",
      "params": {
        "N": 30,
        "P": 10,
        "K": 6,
        "J": 1
      }
    },
    "pre_hankel_input": "P4M6"
  },
  "basin": {
    "_comment": "Basin analysis settings",
    "analysis_enable": false,
    "boundary_file": "",
    "name": "",
    "do_time_series": true,
    "do_statistics": true,
    "do_grid": true,
    "save_ts_txt": true,
    "save_ts_mat": true,
    "save_grid_mat": true
  },
  "leakage": {
    "_comment": "Leakage reduction/correction settings",
    "enable": false,
    "scope": "global",
    "method": "SF",
    "sf_factor": 1.0,
    "sf_auto": false,
    "sf_method": "Auto",
    "sf_gauss_km": 300,
    "sf_fan_r1_km": 300,
    "sf_fan_r2_km": 300,
    "sf_ddk_type": "DDK4",
    "sf_p4_deg": 4,
    "sf_p4_m": 6,
    "sf_grid_interval": 0.5,
    "sf_hsa_window": 60,
    "sf_hsa_p": 20,
    "sf_hsa_order": 6,
    "sf_hsa_buffer": 10,
    "sf_hsa_ts": 1,
    "fm_max_iter": 40,
    "fm_autocap_hsaf_iter": true,
    "fm_hsaf_iter_cap": 40,
    "fm_allow_hsaf_parallel": true,
    "fm_hsaf_use_process_pool": true,
    "fm_hsaf_outer_workers_cap": 12,
    "fm_hsaf_inner_workers": 1,
    "fm_min_iter": 3,
    "fm_tol": 0.01,
    "fm_patience": 8,
    "fm_min_improve": 0.0001,
    "fm_accel": 1.1,
    "fm_metric": "land_weighted_mean",
    "sf_toolbox": "",
    "input": "",
    "output": "",
    "format": "mat",
    "boundary_file": "",
    "script_global": "",
    "script_region": "",
    "matlab": "matlab"
  },
  "metrics": {
    "enable": true,
    "compute_spectrum": false
  },
  "io": {
    "save_monthly_mat": true,
    "save_stack_mat": true,
    "export_txt": false,
    "txt_format": "lonlatval",
    "resume": false,
    "return_stacks": false,
    "return_basin": false,
    "return_metrics": false
  },
  "plot": {
    "quicklook": false,
    "metrics_ts": true,
    "metrics_maps": true,
    "stack_mean": true,
    "stack_trend_amp": true,
    "basin_overlay": true,
    "caxis": {
      "ewh": [-30, 30],
      "trend": [-5, 5],
      "amp": [-15, 15]
    }
  },
  "parallel": {
    "enable": true,
    "nWorkers": 4
  },
  "perf": {
    "allow_frozen_parallel": false,
    "runtime_profile": "balanced",
    "frozen_max_workers": 0
  }
}
